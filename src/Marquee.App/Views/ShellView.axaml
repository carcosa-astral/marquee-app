<!-- Sidebar, top bar and the current page. Matches the Sidebar and Topbar mocks. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marquee.App.ViewModels"
             xmlns:app="using:Marquee.App"
             x:Class="Marquee.App.Views.ShellView"
             x:DataType="vm:ShellViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:NavItemViewModel">
      <Button Classes="nav" Classes.active="{Binding IsActive}" Command="{Binding OpenCommand}">
        <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="12">
          <Viewbox Width="18" Height="18" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Classes="icon" Data="{Binding Icon}" />
            </Canvas>
          </Viewbox>
          <TextBlock Grid.Column="1" Classes="navLabel" Text="{Binding Label}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Count}" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="ItemsControl.nav">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Spacing="2" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="232,*">

    <!-- Sidebar -->
    <Border Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0"
            Padding="12,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0">
            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentBrush}">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Classes="icon" Data="{x:Static app:Icons.Logo}" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2.4" />
                </Canvas>
              </Viewbox>
            </Border>
            <TextBlock Classes="brand" FontSize="18" Text="Marquee" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl Classes="nav" ItemsSource="{Binding MainItems}" />

          <Border Height="1" Margin="10,0" Background="{StaticResource DividerBrush}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="LIBRARY" Margin="10,0" />
            <ItemsControl Classes="nav" ItemsSource="{Binding LibraryItems}" />
          </StackPanel>
        </StackPanel>

        <ItemsControl DockPanel.Dock="Bottom" Classes="nav" ItemsSource="{Binding FooterItems}" VerticalAlignment="Bottom" />
      </DockPanel>
    </Border>

    <!-- Main area -->
    <DockPanel Grid.Column="1">

      <!-- Top bar -->
      <Border DockPanel.Dock="Top" Height="72" Padding="32,0"
              BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="420,*,Auto">
          <TextBox x:Name="TopSearch" VerticalAlignment="Center" Text="{Binding TopQuery}"
                   PlaceholderText="Search titles to add">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding OpenSearchCommand}" />
            </TextBox.KeyBindings>
            <TextBox.InnerLeftContent>
              <Viewbox Width="16" Height="16" Margin="2,0,8,0">
                <Canvas Width="24" Height="24">
                  <Path Classes="icon" Data="{x:Static app:Icons.Search}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" />
                </Canvas>
              </Viewbox>
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Border BorderBrush="{StaticResource QuietBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Classes="muted small" Text="Ctrl K" />
              </Border>
            </TextBox.InnerRightContent>
          </TextBox>

          <Button Grid.Column="2" Classes="primary" IsEnabled="False"
                  ToolTip.Tip="Logging arrives in 0.3.0" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Classes="icon" Data="{x:Static app:Icons.Plus}" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="Log a watch" Foreground="{StaticResource OnAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Page -->
      <ScrollViewer>
        <ContentControl Content="{Binding CurrentPage}" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
