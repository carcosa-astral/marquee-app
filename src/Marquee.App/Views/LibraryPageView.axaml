<!-- Poster grid for Movies, TV or Anime. Matches the grid in docs/design/mocks/Library.dc.html; filters arrive in 0.9.0. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marquee.App.ViewModels"
             x:Class="Marquee.App.Views.LibraryPageView"
             x:DataType="vm:LibraryPageViewModel">
  <StackPanel Margin="32,28,32,32" Spacing="22">
    <StackPanel Spacing="4">
      <TextBlock Classes="section" Text="{Binding CountText}" />
      <TextBlock Classes="h1" Text="{Binding Title}" />
    </StackPanel>

    <Border Classes="card" Padding="24,22" MaxWidth="720" HorizontalAlignment="Left" IsVisible="{Binding IsEmpty}">
      <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{Binding EmptyText}" />
    </Border>

    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="16" LineSpacing="20" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryItemViewModel">
          <StackPanel Width="148" Spacing="7">
            <Button Classes="segment" Padding="0" Width="148" Height="222" CornerRadius="7" Background="Transparent"
                    Command="{Binding OpenCommand}" ToolTip.Tip="Log a watch">
              <Border Classes="poster" Width="148" Height="222" CornerRadius="7">
                <Panel>
                  <TextBlock Classes="brand" FontSize="13" Margin="10" TextWrapping="Wrap" VerticalAlignment="Bottom" Text="{Binding Name}" />
                  <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                </Panel>
              </Border>
            </Button>
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}"
                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <TextBlock Classes="muted small" Margin="0,-4,0,0" Text="{Binding Details}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
