<!-- First run. Matches docs/design/mocks/Setup.dc.html. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marquee.App.ViewModels"
             xmlns:app="using:Marquee.App"
             x:Class="Marquee.App.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <Panel>
    <Border Background="{StaticResource AppBackgroundBrush}" />
    <Border Background="{StaticResource SetupGlowBrush}" />

    <ScrollViewer>
      <StackPanel Width="700" Margin="0,24" Spacing="26" HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Heading -->
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentBrush}">
              <Viewbox Width="22" Height="22">
                <Canvas Width="24" Height="24">
                  <Path Classes="icon" Data="{x:Static app:Icons.Logo}" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2.4" />
                </Canvas>
              </Viewbox>
            </Border>
            <TextBlock Classes="brand" FontSize="24" Text="Marquee" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="display" Text="Set up your diary" />
          <TextBlock Classes="subtle" FontSize="15" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                     Text="Three quick steps. Everything stays in one file on this computer, and nothing comes preloaded." />
        </StackPanel>

        <Border Classes="card">
          <StackPanel>

            <!-- Step 1 -->
            <Grid ColumnDefinitions="28,*" ColumnSpacing="18" Margin="24,22">
              <Border Classes="step"><TextBlock Text="1" /></Border>
              <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Classes="h2" Text="Everything stays in your Marquee folder" />
                <Border Classes="inset" Padding="16,14">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" Text="{Binding FolderName}" ToolTip.Tip="{Binding FolderPath}" />
                      <TextBlock FontSize="13" Classes="muted" Text="the folder you opened this app from" />
                    </StackPanel>
                    <Grid ColumnDefinitions="148,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" Margin="18,0,0,0">
                      <Grid.Styles>
                        <Style Selector="TextBlock">
                          <Setter Property="FontSize" Value="13" />
                        </Style>
                        <Style Selector="TextBlock.name">
                          <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
                        </Style>
                      </Grid.Styles>
                      <TextBlock Classes="name" Text="Marquee app" />
                      <TextBlock Grid.Column="1" Classes="muted" Text="the program itself" />
                      <TextBlock Grid.Row="1" Classes="name" Text="data/marquee.db" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="your diary, one SQLite file" />
                      <TextBlock Grid.Row="2" Classes="name" Text="data/images/" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" Text="saved posters and photos" />
                      <TextBlock Grid.Row="3" Classes="name" Text="backups/ and exports/" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" Text="automatic backups and your JSON files" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="No installer and no hidden system folders. Move or copy the whole Marquee folder to take everything with you." />
              </StackPanel>
            </Grid>

            <!-- Step 2 -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="18" Margin="24,22">
                <Border Classes="step"><TextBlock Text="2" /></Border>
                <StackPanel Grid.Column="1" Spacing="10">
                  <TextBlock Classes="h2" Text="Connect your movie and TV data" />
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="TMDB API key" />
                    <TextBox Text="{Binding TmdbKey}" PlaceholderText="Paste your key" />
                    <TextBlock Classes="muted small" TextWrapping="Wrap"
                               Text="Free from your TMDB account. Saved inside your Marquee folder only. You can also add it later in Settings." />
                  </StackPanel>
                  <Border Classes="inset" Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                          <Path Classes="icon" Data="{x:Static app:Icons.Check}" Stroke="{StaticResource WatchedBrush}" StrokeThickness="2.4" />
                        </Canvas>
                      </Viewbox>
                      <TextBlock Foreground="{StaticResource TextStrongBrush}" Text="AniList for anime" VerticalAlignment="Center" />
                      <TextBlock FontSize="13" Classes="subtle" Text="No key needed. Ready to use." VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Step 3 -->
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="28,*" ColumnSpacing="18" Margin="24,22">
                <Border Classes="step"><TextBlock Text="3" /></Border>
                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Classes="h2" Text="Start fresh or bring your data" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Classes="choice selected">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextStrongBrush}" Text="Start empty" />
                        <TextBlock FontSize="13" Classes="subtle" Text="A blank diary. Add titles as you watch." />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="choice" IsEnabled="{Binding CanImport}"
                            ToolTip.Tip="Importing arrives in 0.8.0" ToolTip.ShowOnDisabled="True">
                      <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextStrongBrush}" Text="Import a Marquee JSON" />
                        <TextBlock FontSize="13" Classes="subtle" Text="Restore a diary you exported before." />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <TextBlock FontSize="13" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Theaters, people and tags start empty too. You add your own as you go." />
          <Button Grid.Column="1" Classes="primary" Height="44" Padding="26,0" FontSize="15"
                  Content="Open Marquee" Command="{Binding OpenCommand}" IsDefault="True" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Panel>

  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.step > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
</UserControl>
