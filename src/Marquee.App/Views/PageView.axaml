<!-- A placeholder page for the skeleton. Real pages replace it milestone by milestone. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Marquee.App.ViewModels"
             x:Class="Marquee.App.Views.PageView"
             x:DataType="vm:PageViewModel">
  <StackPanel Margin="32,28,32,32" Spacing="22">
    <StackPanel Spacing="10">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="subtle" FontSize="15" TextWrapping="Wrap" Text="{Binding Description}" />
    </StackPanel>

    <Border Classes="card" Padding="24,22" IsVisible="{Binding HasCard}" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Classes="h2" Text="{Binding CardTitle}" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{Binding CardText}" />
      </StackPanel>
    </Border>

    <Border Classes="card" Padding="24,18" IsVisible="{Binding HasDetails}" MaxWidth="900" HorizontalAlignment="Left">
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DetailRow">
            <Grid ColumnDefinitions="160,*" ColumnSpacing="16" Margin="0,6">
              <TextBlock Classes="muted" Text="{Binding Label}" />
              <SelectableTextBlock Grid.Column="1" Foreground="{StaticResource TextStrongBrush}" TextWrapping="Wrap" Text="{Binding Value}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasFootnote}" Text="{Binding Footnote}" />
  </StackPanel>
</UserControl>
