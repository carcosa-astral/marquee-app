<!-- Shared control styles. Colors come from Nord.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Type -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="LetterSpacing" Value="-0.9" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LetterSpacing" Value="-0.8" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- Line icons drawn in a 24 by 24 box, like the mocks -->
  <Style Selector="Path.icon">
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{StaticResource TextNavBrush}" />
  </Style>

  <!-- Primary button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Height" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.primary Path.icon">
    <Setter Property="Stroke" Value="{StaticResource OnAccentBrush}" />
    <Setter Property="StrokeThickness" Value="2.4" />
  </Style>

  <!-- Secondary button -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

  <!-- Accent outline button, such as "Add a theater" in the log dialog -->
  <Style Selector="Button.accentOutline">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.accentOutline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>

  <!-- Segmented control: a row of choices on a raised strip, one selected -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.segment.active">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>

  <!-- Option buttons: formats and similar choices. Add "round" for pill shapes. -->
  <Style Selector="Button.option">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.option.round">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.option.active">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.option.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
  </Style>
  <Style Selector="Button.option.add">
    <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
  </Style>

  <!-- Inputs that use Fluent templates: match the text boxes -->
  <Style Selector="ComboBox, CalendarDatePicker, AutoCompleteBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="AutoCompleteBox /template/ TextBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Table rows that open something, such as diary entries and theaters -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
  </Style>
  <Style Selector="Button.row.selected">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.row.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.rewatch"><Setter Property="Background" Value="{StaticResource AnimeSoftBrush}" /><Setter Property="Padding" Value="6,2" /></Style>
  <Style Selector="Border.pill.rewatch > TextBlock"><Setter Property="Foreground" Value="{StaticResource WatchlistBrush}" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="0.4" /></Style>

  <!-- Dialog surface -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="{StaticResource DialogShadow}" />
  </Style>

  <!-- Filter chips -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.chip.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
  </Style>
  <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Small pills: title kind and metadata source -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Border.pill.movie"><Setter Property="Background" Value="{StaticResource MovieSoftBrush}" /></Style>
  <Style Selector="Border.pill.movie > TextBlock"><Setter Property="Foreground" Value="{StaticResource MovieBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.pill.tv"><Setter Property="Background" Value="{StaticResource TvSoftBrush}" /></Style>
  <Style Selector="Border.pill.tv > TextBlock"><Setter Property="Foreground" Value="{StaticResource TvBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.pill.anime"><Setter Property="Background" Value="{StaticResource AnimeSoftBrush}" /></Style>
  <Style Selector="Border.pill.anime > TextBlock"><Setter Property="Foreground" Value="{StaticResource AnimeBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.pill.tmdb"><Setter Property="Background" Value="{StaticResource TmdbTagSoftBrush}" /></Style>
  <Style Selector="Border.pill.tmdb > TextBlock"><Setter Property="Foreground" Value="{StaticResource TmdbTagBrush}" /></Style>
  <Style Selector="Border.pill.anilist"><Setter Property="Background" Value="{StaticResource AniListTagSoftBrush}" /></Style>
  <Style Selector="Border.pill.anilist > TextBlock"><Setter Property="Foreground" Value="{StaticResource AniListTagBrush}" /></Style>

  <!-- Posters -->
  <Style Selector="Border.poster">
    <Setter Property="Background" Value="{StaticResource PosterPlaceholderBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
  </Style>
  <Style Selector="Button.nav TextBlock.navLabel">
    <Setter Property="Foreground" Value="{StaticResource TextNavBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
  </Style>
  <Style Selector="Button.nav.active TextBlock.navLabel">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.active Path.icon">
    <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Large choice buttons on the setup screen -->
  <Style Selector="Button.choice">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
  </Style>
  <Style Selector="Button.choice.selected">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.choice.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Text boxes -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource QuietBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>
</Styles>
