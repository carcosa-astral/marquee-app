<!--
  The Nord palette and Marquee's semantic tokens. Views use the brushes below,
  never raw hex values. See docs/BUILD_PLAN.md, section 9.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Polar Night -->
  <Color x:Key="Nord0">#2E3440</Color>
  <Color x:Key="Nord1">#3B4252</Color>
  <Color x:Key="Nord2">#434C5E</Color>
  <Color x:Key="Nord3">#4C566A</Color>
  <!-- Snow Storm -->
  <Color x:Key="Nord4">#D8DEE9</Color>
  <Color x:Key="Nord5">#E5E9F0</Color>
  <Color x:Key="Nord6">#ECEFF4</Color>
  <!-- Frost -->
  <Color x:Key="Nord7">#8FBCBB</Color>
  <Color x:Key="Nord8">#88C0D0</Color>
  <Color x:Key="Nord9">#81A1C1</Color>
  <Color x:Key="Nord10">#5E81AC</Color>
  <!-- Aurora -->
  <Color x:Key="Nord11">#BF616A</Color>
  <Color x:Key="Nord12">#D08770</Color>
  <Color x:Key="Nord13">#EBCB8B</Color>
  <Color x:Key="Nord14">#A3BE8C</Color>
  <Color x:Key="Nord15">#B48EAD</Color>
  <!-- Extra shades used by the mocks -->
  <Color x:Key="NordSidebar">#272C36</Color>
  <Color x:Key="NordCard">#343A47</Color>
  <Color x:Key="NordMuted">#98A3B8</Color>
  <Color x:Key="NordSubtle">#B8C2D4</Color>
  <Color x:Key="NordAccentSoft">#1F88C0D0</Color>
  <Color x:Key="NordAccentGlow">#2E88C0D0</Color>

  <!-- Surfaces -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Nord0}" />
  <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource NordSidebar}" />
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource NordCard}" />
  <SolidColorBrush x:Key="RaisedBackgroundBrush" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource Nord1}" />

  <!-- Lines -->
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource Nord2}" />
  <SolidColorBrush x:Key="QuietBorderBrush" Color="{StaticResource Nord3}" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextStrongBrush" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource Nord5}" />
  <SolidColorBrush x:Key="TextNavBrush" Color="{StaticResource Nord4}" />
  <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource NordSubtle}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource NordMuted}" />

  <!-- Accent -->
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource Nord0}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource NordAccentSoft}" />

  <!-- Title types -->
  <SolidColorBrush x:Key="MovieBrush" Color="{StaticResource Nord9}" />
  <SolidColorBrush x:Key="TvBrush" Color="{StaticResource Nord15}" />
  <SolidColorBrush x:Key="AnimeBrush" Color="{StaticResource Nord13}" />
  <SolidColorBrush x:Key="MovieSoftBrush" Color="#2E81A1C1" />
  <SolidColorBrush x:Key="TvSoftBrush" Color="#2EB48EAD" />
  <SolidColorBrush x:Key="AnimeSoftBrush" Color="#29EBCB8B" />

  <!-- Metadata source tags -->
  <SolidColorBrush x:Key="TmdbTagBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="TmdbTagSoftBrush" Color="#2488C0D0" />
  <SolidColorBrush x:Key="AniListTagBrush" Color="{StaticResource Nord13}" />
  <SolidColorBrush x:Key="AniListTagSoftBrush" Color="#24EBCB8B" />

  <!-- Shown where a poster is missing or still loading -->
  <LinearGradientBrush x:Key="PosterPlaceholderBrush" StartPoint="0%,0%" EndPoint="60%,100%">
    <GradientStop Offset="0" Color="{StaticResource Nord3}" />
    <GradientStop Offset="1" Color="{StaticResource Nord0}" />
  </LinearGradientBrush>

  <!-- Title pages -->
  <SolidColorBrush x:Key="ImdbBrush" Color="{StaticResource Nord13}" />
  <SolidColorBrush x:Key="EpisodeWatchedBrush" Color="#4C6A82" />
  <SolidColorBrush x:Key="WatchedSoftBrush" Color="#29A3BE8C" />
  <LinearGradientBrush x:Key="BackdropPlaceholderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="{StaticResource Nord1}" />
    <GradientStop Offset="1" Color="{StaticResource Nord0}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BackdropFadeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.35" Color="#002E3440" />
    <GradientStop Offset="1" Color="#CC2E3440" />
  </LinearGradientBrush>

  <!-- Ratings -->
  <SolidColorBrush x:Key="RatingBrush" Color="{StaticResource Nord13}" />
  <SolidColorBrush x:Key="RatingEmptyBrush" Color="{StaticResource Nord2}" />

  <!-- Segmented controls and selected choices -->
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource Nord10}" />

  <!-- Dialogs -->
  <SolidColorBrush x:Key="ScrimBrush" Color="#B3232831" />
  <BoxShadows x:Key="DialogShadow">0 16 48 0 #66000000</BoxShadows>
  <SolidColorBrush x:Key="DialogBorderBrush" Color="{StaticResource Nord3}" />

  <!-- Status -->
  <SolidColorBrush x:Key="WatchedBrush" Color="{StaticResource Nord14}" />
  <SolidColorBrush x:Key="WatchlistBrush" Color="{StaticResource Nord13}" />
  <SolidColorBrush x:Key="PausedBrush" Color="{StaticResource Nord9}" />
  <SolidColorBrush x:Key="DroppedBrush" Color="{StaticResource Nord12}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Nord11}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Nord12}" />

  <!-- Setup screen glow, from the Setup mock -->
  <RadialGradientBrush x:Key="SetupGlowBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="70%" RadiusY="90%">
    <GradientStop Offset="0" Color="{StaticResource NordAccentGlow}" />
    <GradientStop Offset="0.6" Color="#0088C0D0" />
  </RadialGradientBrush>

  <!-- Fonts, bundled with fallbacks -->
  <FontFamily x:Key="HeadingFont">avares://Marquee/Assets/Fonts#Bricolage Grotesque, Segoe UI, Helvetica Neue, Arial</FontFamily>
  <FontFamily x:Key="BodyFont">avares://Marquee/Assets/Fonts#Hanken Grotesk, Segoe UI, Helvetica Neue, Arial</FontFamily>

  <!-- Fluent theme hooks so built-in controls pick up Nord -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource Nord2}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource NordMuted}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource NordMuted}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource NordMuted}" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource Nord2}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="CalendarDatePickerBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarDatePickerBackgroundPointerOver" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarDatePickerBackgroundPressed" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarDatePickerBackgroundFocused" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarDatePickerBorderBrush" Color="{StaticResource Nord2}" />
  <SolidColorBrush x:Key="CalendarDatePickerBorderBrushPointerOver" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="CalendarDatePickerForeground" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="CalendarDatePickerCalendarGlyphForeground" Color="{StaticResource NordMuted}" />
  <SolidColorBrush x:Key="CalendarDatePickerLightDismissOverlayBackground" Color="Transparent" />
  <SolidColorBrush x:Key="CalendarViewBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarViewBorderBrush" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarViewForeground" Color="{StaticResource Nord6}" />
  <SolidColorBrush x:Key="CalendarViewCalendarItemForeground" Color="{StaticResource Nord4}" />
  <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBorderBrush" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarViewOutOfScopeBackground" Color="{StaticResource Nord1}" />
  <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="CalendarViewBlackoutForeground" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="CalendarViewWeekDayForegroundDisabled" Color="{StaticResource NordMuted}" />
  <SolidColorBrush x:Key="CalendarViewTodayForeground" Color="{StaticResource Nord0}" />
  <SolidColorBrush x:Key="CalendarViewHoverBorderBrush" Color="{StaticResource Nord3}" />
  <SolidColorBrush x:Key="CalendarViewPressedBorderBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="CalendarViewSelectedHoverBorderBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="CalendarViewSelectedPressedBorderBrush" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="CalendarViewNavigationButtonBackground" Color="Transparent" />
  <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="CalendarViewNavigationButtonBorderBrushPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPointerOver" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="CalendarViewNavigationButtonForegroundPressed" Color="{StaticResource Nord8}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Nord14}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Nord14}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Nord14}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Nord0}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Nord0}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource Nord0}" />
  <Color x:Key="SystemAccentColor">#88C0D0</Color>
  <Color x:Key="SystemAccentColorDark1">#81A1C1</Color>
  <Color x:Key="SystemAccentColorLight1">#8FBCBB</Color>
</ResourceDictionary>
